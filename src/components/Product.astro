---
import PatternMain from "../assets/images/background/patternmain.png"
import BocahSd from "../assets/images/Products/Lvl_Bocah_Sd.png"
import BocahSmp from "../assets/images/Products/Lvl_Bocah_Smp.png"
import BocahSmk from "../assets/images/Products/Lvl_Bocah_Smk.png"
import Paket from "../assets/images/Products/Lvl_all.png"
---

<main id="Product" class="flex flex-col bg-cover bg-no-repeat min-h-screen">
  <div class="flex flex-col gap-8 py-12 px-6 md:px-16">
    
    <!-- Heading -->
    <h2 class="text-3xl md:text-4xl text-center font-[PoppinsBold] text-[#E4E4E4]">
      PRODUCTS
    </h2>

    <!-- Navigation Buttons -->
    <div class="navigation flex flex-wrap justify-center gap-3 md:gap-5 text-[#E4E4E4] font-[PoppinsSemibold]">
      <button class="bg-[#262626] px-4 py-2 rounded-lg hover:bg-[#EA6D00] hover:text-[#E4E4E4] transition">Cari Produk</button>
      <button class="bg-[#262626] px-4 py-2 rounded-lg hover:bg-[#EA6D00] hover:text-[#E4E4E4] transition">Harga Min</button>
      <button class="bg-[#262626] px-4 py-2 rounded-lg hover:bg-[#EA6D00] hover:text-[#E4E4E4] transition">Harga Max</button>
      <button class="bg-[#262626] px-4 py-2 rounded-lg hover:bg-[#EA6D00] hover:text-[#E4E4E4] transition">Urutkan</button>
      <button class="bg-[#262626] px-4 py-2 rounded-lg hover:bg-[#EA6D00] hover:text-[#E4E4E4] transition">Reset</button>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 justify-items-center">
      
      <!-- Item 1 -->
      <div class="items flex flex-col bg-[#E4E4E4] rounded-lg max-w-[160px] hover:scale-105 transition-transform">
        <img src={BocahSd.src} class="rounded-t-lg" alt="Bocah SD" />
        <div class="info p-3 text-center">
          <p class="font-[PoppinsSemibold] text-[#561306] text-sm">Kripik Cumi Hytam pak Kris Lvl. <span>SD</span></p>
          <span class="block font-[PoppinsBold] text-[#EA6D00]">RP. 8.500</span>
          <button class="font-[PoppinsBold] mt-2 bg-[#EA6D00] text-[#E4E4E4] px-4 py-1.5 rounded-lg hover:bg-[#E4E4E4] hover:text-[#EA6D00] transition">
            +Keranjang
          </button>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="items flex flex-col bg-[#E4E4E4] rounded-lg max-w-[160px] hover:scale-105 transition-transform">
        <img src={BocahSmp.src} class="rounded-t-lg" alt="Bocah SMP" />
        <div class="info p-3 text-center">
          <p class="font-[PoppinsSemibold] text-[#561306] text-sm">Kripik Cumi Hytam pak Kris Lvl. <span>SMP</span></p>
          <span class="block font-[PoppinsBold] text-[#EA6D00]">RP. 8.500</span>
          <button class="font-[PoppinsBold] mt-2 bg-[#EA6D00] text-[#E4E4E4] px-4 py-1.5 rounded-lg hover:bg-[#E4E4E4] hover:text-[#EA6D00] transition">
            +Keranjang
          </button>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="items flex flex-col bg-[#E4E4E4] rounded-lg max-w-[160px] hover:scale-105 transition-transform">
        <img src={BocahSmk.src} class="rounded-t-lg" alt="Bocah SMK" />
        <div class="info p-3 text-center">
          <p class="font-[PoppinsSemibold] text-[#561306] text-sm">Kripik Cumi Hytam pak Kris Lvl. <span>SMK</span></p>
          <span class="block font-[PoppinsBold] text-[#EA6D00]">RP. 8.500</span>
          <button class="font-[PoppinsBold] mt-2 bg-[#EA6D00] text-[#E4E4E4] px-4 py-1.5 rounded-lg hover:bg-[#E4E4E4] hover:text-[#EA6D00] transition">
            +Keranjang
          </button>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="items flex flex-col bg-[#E4E4E4] rounded-lg max-w-[160px] hover:scale-105 transition-transform">
        <img src={Paket.src} class="rounded-t-lg" alt="Bundle" />
        <div class="info p-3 text-center">
          <p class="font-[PoppinsSemibold] text-[#561306] text-sm">Kripik Cumi Hytam pak Kris <span>Bundle</span></p>
          <span class="block font-[PoppinsBold] text-[#EA6D00]">RP. 21.000</span>
          <button class="font-[PoppinsBold] mt-2 bg-[#EA6D00] text-[#E4E4E4] px-4 py-1.5 rounded-lg hover:bg-[#E4E4E4] hover:text-[#EA6D00] transition">
            +Keranjang
          </button>
        </div>
      </div>

    </div>
  </div>
</main>

<style>
  main{
    background-image: url("../assets/images/background/patternmain.png");
  }
</style>
