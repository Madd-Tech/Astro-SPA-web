---
import PatternContact from "../assets/images/background/patternContact.png"
import PatternMain from "../assets/images/background/patternmain.png"
import contact from "../assets/images/Contact Us/Contactus.svg";
import Email from "../assets/images/Contact Us/EmailIcon.svg";
import Phone from "../assets/images/Contact Us/WhatsappIcon.svg";
import Location from "../assets/images/Contact Us/MapsIcon.svg";
import WhatsApp from "../assets/images/Contact Us/PhoneIcon.svg";
---

<main class="flex flex-col text-[#e4e4e4] font-[Poppins]">
  <!-- HEADER -->
  <div
    class="head w-full flex justify-center items-center p-10 bg-cover bg-no-repeat"
   
  >
    <img src={contact.src} class="w-64 md:w-80" alt="contact us" />
  </div>

  <!-- FORM & ICON WRAPPER -->
  <div
    class="form flex flex-col md:flex-row justify-evenly items-start gap-10 p-10 bg-cover bg-no-repeat"
  >
    <!-- FORM -->
     
    <form
      action=""
      class="w-full md:w-1/2 space-y-6 bg-[#561306]/20 backdrop-blur-sm p-6 rounded-xl"
    >
     <h2 class="font-[PoppinsSemiBold]">Sending email to us!</h2>
      <div class="flex flex-col">
        <label for="email" class="font-[PoppinsSemiBold] mb-1">Email</label>
        <input
          type="email"
          name="email"
          required
          placeholder="Enter your email..."
          class="bg-[#e4e4e4] text-[#262626] rounded-lg p-2 focus:ring-2 focus:ring-[#561306] outline-none"
        />
      </div>

      <div class="flex flex-col">
        <label for="name" class="font-[PoppinsSemiBold] mb-1">Name</label>
        <input
          type="text"
          name="name"
          required
          placeholder="Enter your name..."
          class="bg-[#e4e4e4] text-[#262626] rounded-lg p-2 focus:ring-2 focus:ring-[#561306] outline-none"
        />
      </div>

      <div class="flex flex-col">
        <label for="feedback" class="font-[PoppinsSemiBold] mb-1">Feedback</label>
        <textarea
          name="feedback"
          rows="4"
          required
          placeholder="What's your feedback?"
          class="bg-[#e4e4e4] text-[#262626] rounded-lg p-2 resize-none focus:ring-2 focus:ring-[#561306] outline-none"
        ></textarea>
      </div>

      <button
        type="submit"
        class="bg-[#561306] hover:bg-[#e4e4e4] hover:text-[#561306] text-white font-[PoppinsSemiBold] px-5 py-2 rounded-lg transition duration-300"
      >
        Submit
      </button>
    </form>

    <!-- ICONS (manual 4 item) -->
    <div
      class="grid grid-cols-2 grid-rows-2 gap-4 w-full md:w-1/2 place-items-center"
    >
   
      <div
        class="icons flex flex-col items-center justify-center gap-2 p-6 rounded-xl bg-[#561306] shadow-md hover:scale-105 transition-transform duration-300 w-full max-w-[200px]"
      >
        <img src={Email.src} width="60" alt="email icon" />
        <h3 class="font-[PoppinsSemiBold] text-white">Email</h3>
        <p class="text-sm break-words text-center">cumiqofficial@gmail.com</p>
      </div>

      <div
        class="icons flex flex-col items-center justify-center gap-2 p-6 rounded-xl bg-[#561306] shadow-md hover:scale-105 transition-transform duration-300 w-full max-w-[200px]"
      >
        <img src={WhatsApp.src} width="60" alt="phone icon" />
        <h3 class="font-[PoppinsSemiBold] text-white">WhatsApp</h3>
        <p class="text-sm break-words text-center">+62(812) 837 40101</p>
      </div>

      <div
        class="icons flex flex-col items-center justify-center gap-2 p-6 rounded-xl bg-[#561306] shadow-md hover:scale-105 transition-transform duration-300 w-full max-w-[200px]"
      >
        <img src={Location.src} width="60" alt="location icon" />
        <h3 class="font-[PoppinsSemiBold] text-white">Adress</h3>
        <p class="text-sm break-words text-center">Dapura foodcourt, Jl. Meruya Ilir Raya</p>
      </div>

      <div
        class="icons flex flex-col items-center justify-center gap-2 p-6 rounded-xl bg-[#561306] shadow-md hover:scale-105 transition-transform duration-300 w-full max-w-[200px]"
      >
        <img src={Phone.src} width="60" alt="website icon" />
        <h3 class="font-[PoppinsSemiBold] text-white">Phone</h3>
        <p class="text-sm break-words text-center">333444</p>
      </div>
    </div>
  </div>
</main>

<style>
  @font-face {
    font-family: "Poppins";
    src: url("../assets/fonts/Poppins/Poppins-Light.ttf");
  }
  @font-face {
    font-family: "PoppinsSemiBold";
    src: url("../assets/fonts/Poppins/Poppins-SemiBold.ttf");
  }
  .head{
    background-image: url('../assets/images/background/patternContact.png');
  }
  .form{
    background-image: url('../assets/images/background/patternmain.png');
  }

  /* Sembunyikan icon di mobile */
  @media (max-width: 640px) {
    .icons {
      display: none;
    }
    
  }
</style>
