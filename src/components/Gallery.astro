---
import Gallery1 from "../assets/images/Gallery/gallery1.png"
import Gallery2 from "../assets/images/Gallery/gallery2.png"
import Gallery3 from "../assets/images/Gallery/gallery3.png"
import Carousels from "./function/Carousels.astro";
---

<main class="flex flex-col gap:4 md:flex-row p-10 justify-evenly" id="Gallery">
  <!-- Carousels di view mobile -->
  <section class="md:hidden flex">
    <Carousels/>
  </section>
  
   <section class="hidden md:flex w-full justify-evenly">
   <div class="parents  md:h-full md:w-78  flex-col p-md rounded-bl-[50px] rounded-tr-[50px]">
     <div class="child">
       <img src={Gallery1.src} class=" w-full object-cover rounded-tr-[50px]" alt="Gallery1">
     </div>
     <div class="child rounded-bl-[50px] py-4 px-4">
        <h3>SENSATION</h3>
        <p>Rasakan sensasi renyah dan gurih dari keripik cumi pilihan yang bikin lidah tak berhenti mengunyah!.
        </p>
     </div>
   </div>

   <div class="parents  md:h-full md:w-78  flex-col p-md rounded-bl-[50px] rounded-tr-[50px]">
     <div class="child">
       <img src={Gallery2.src} class=" w-full object-cover rounded-tr-[50px]" alt="Gallery1">
     </div>
     <div class="child rounded-bl-[50px] py-4 px-4">
        <h3>FLAVOUR</h3>
        <p>Terbuat dari cumi asli dan bumbu rempah khas nusantara, menghadirkan cita rasa yang istimewa.
        </p>
     </div>
   </div>
   <div class="parents  md:h-full md:w-78  flex-col p-md rounded-bl-[50px] rounded-tr-[50px]">
     <div class="child">
       <img src={Gallery3.src} class=" w-full object-cover rounded-tr-[50px]" alt="Gallery1">
     </div>
     <div class="child rounded-bl-[50px] py-4 px-4">
        <h3>HAPPINES</h3>
        <p>Bagikan kebahagiaan sederhana bersama keluarga lewat renyahnya keripik cumi setiap waktu.
     </div>
   </div>

</section>
</main>

<style>
    .parents{
        /* border:2px solid #EA6D00; */
    }
    .parents .child:nth-child(2){
        color:#E4E4E4;
      background-color: #561306;
      font-family: "Poppins";
    }
    h3{
        font-family: "PoppinsBold";
    }

     @font-face {
        font-family: "Poppins";
        src: url("../assets/fonts/Poppins/Poppins-Light.ttf");
    }
  	 @font-face {
        font-family: "PoppinsBold";
        src: url("../assets/fonts/Poppins/Poppins-Bold.ttf");
    }
</style>