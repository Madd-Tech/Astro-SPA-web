---
import cartLogo from "../assets/icons/shopingcart.svg";
import mainLogo from "../assets/icons/logo.svg";
---

<nav id="nav" class="flex sticky top-0 z-100 items-center rounded-bl-2xl rounded-br-2xl justify-between w-full px-6 p-2 shadow-md bg-white text-gray-800 relative">
  <!-- Logo -->
  <div class="flex items-center gap-2">
    <a href="#nav">
    <img
      src={mainLogo.src}
      width="150"
      height="80"
      alt="Cart Logo"
      class="transition duration-300 hover:drop-shadow-[0_0_10px_#D64218] hover:brightness-125"
    />
    </a>
  </div>

  <!-- Tombol hamburger -->
  <button id="menu-toggle" class="block md:hidden focus:outline-none z-20 relative">
    <svg
      id="hamburger-icon"
      class="w-7 h-7 transition-transform duration-300"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <!-- Menu navigasi -->
  <ul
    id="menu"
    class="max-h-0 overflow-hidden transition-all duration-500 ease-in-out md:max-h-none md:flex
     flex-col md:flex-row gap-4 md:gap-9 absolute md:static font-semibold md:bg-transparent left-0 
     w-full md:w-auto top-16 md:top-auto p-0 md:p-0 shadow-md md:shadow-none"
  >
    <li><a href="#profile" class="block px-4 py-2 ">Profile</a></li> <!--direct to profile section -->
    <li><a href="#" class="block px-4 py-2 ">Gallery</a></li>
    <li><a href="#" class="block px-4 py-2 ">Contact</a></li>
  </ul>

    <img
      src={cartLogo.src}
      width="40"
      height="40"
      alt="Cart Logo"
      class="transition duration-300 hover:drop-shadow-[0_0_10px_#e4e4e4] hover:brightness-125"
    />
</nav>


<!-- Script untuk toggle animasi -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('menu');
    const icon = document.getElementById('hamburger-icon');

    // fungsi slide down & up pada mobile device
    toggle.addEventListener('click', () => {

      if (menu.classList.contains('max-h-0')) {
        menu.classList.remove('max-h-0');
        menu.classList.add('max-h-96', 'p-4'); // tampil dengan animasi slide down
      } else {
        menu.classList.add('max-h-0');
        menu.classList.remove('max-h-96', 'p-4'); // tutup dengan animasi slide up
      }

      icon.classList.toggle('rotate-90');
    });
  });
</script>

<style>
    nav{
        background-color: #262626;
        color:#e4e4e4;
    }
    ul{
        background-color: #262626;
    }
    ul li:hover{
     color:#D64218;
     text-decoration: underline;
    }
    
</style>
