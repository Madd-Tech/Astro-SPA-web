---
import Nav from "./Nav.astro";
---

<main>
    <Nav />
  
    <div class="parents">
          <div class="overlay h-full px-12 py-8 flex flex-col md:flex-row">
              <div class="child md:px-10 md:items-center md:justify-center md:py-7">
                  <h1 style="font-family:'Montserrat' " class="text-5xl text-primary font-bold">Temukan Rasa disetiap suapan</h1>
                   <p class="w-50 md:w-150 md:text-center">Lorem ipsum dolor sit amet consectetur adipisicing elit. Nisi veritatis
                     totam eos, dicta autem recusandae ullam cum consequuntur dolor quod. 
                     Explicabo, quam? Dolorem cumque tenetur sit maxime facilis vitae modi.</p>
              </div>
              <div class="child">
                <img src="../assets/images/Hero_Content_Polos.png" alt="Slog">
              </div>
              <div class="child">
                <button class="btn btn-xs sm:btn-sm md:btn-md lg:btn-lg xl:btn-xl"><a href="">Pesan Sekarang!</a></button>
              </div>
          </div>
    </div>
</main>

<style>
    @font-face {
        font-family: "Montserrat";
        src: url("../assets/fonts/Montserrat/Montserrat-VariableFont_wght.ttf");
    }
    @font-face {
        font-family: "MontserratItalic";
        src: url("../assets/fonts/Montserrat/Montserrat-Italic-VariableFont_wght.ttf");
    }
    main {
        background-image: url("../assets/images/Hero_Content_Polos.png");
        height: 100vh;
        background-repeat: no-repeat;
        background-size: cover;
        color:#E4E4E4;
    }
    .overlay {
        background-color: hsla(0, 0%, 0%, 0.543);
        
    }
</style>
