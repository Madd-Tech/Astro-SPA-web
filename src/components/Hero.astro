---
import Nav from "./Nav.astro";
import Slog from "../assets/images/Hero_Content_Tittle2.png"
---

<main id="Hero" class="rounded-bl-[40px] rounded-br-[40px]">
    <!-- <Nav /> Navbar components -->

    <div>
        <div class="overlay h-full px-12 py-8 flex flex-col md:flex-row">
            <div
                class="child md:px-10 md:items-center  md:justify-center md:py-7"
            >
            <div class="typho mb-4">
                <h1 style="font-family:'Montserrat'"class="text-5xl text-primary font-bold">
                    Temukan Rasa disetiap suapan
                </h1> <!-- hero section header -->
                <p class="w-50 md:w-150 md:text-left">  <!-- hero section caption -->
                   Keripik Cumi GurihPedas menghadirkan sensasi kriuk yang bikin nagih, cita rasa laut yang autentik, dan kebahagiaan di setiap gigitan!,
                   Setiap gigitan memberi sensasi laut yang autentik, seolah kamu sedang menikmati cumi segar langsung dari pantai.
                   Karena bagi kami, kebahagiaan sejati adalah saat kamu tersenyum menikmati lezatnya keripik cumi buatan lokal.
                </p>
            </div>
            <div class="flex flex-col gap-4 md:flex-row"> <!-- buttons group -->

                <button
                    class="px-3 py-1.5  rounded-lg text-white "
                >
                <a href=" " class=" decoration-red-600/30">
                    Pesan Sekarang!
                </a>  <!-- direct to order page -->
                </button>
                <span class="text-center italic font-sm">atau</span>
                <button
                    class="px-3 py-1.5 rounded-lg text-white"
                >
                <a href=" " class="decoration-red-600/30">
                    Tanya Penjual
                </a> <!--direct to message seller -->
                </button>
            </div>
            </div>
            <div class="child hidden md:flex">
                <img src={Slog.src}  alt="Slog" />
            </div>
        </div>
    </div>
</main>

<style>
    @font-face {
        font-family: "Montserrat";
        src: url("../assets/fonts/Montserrat/Montserrat-VariableFont_wght.ttf");
    }
    @font-face {
        font-family: "MontserratItalic";
        src: url("../assets/fonts/Montserrat/Montserrat-Italic-VariableFont_wght.ttf");
    }
     @font-face {
        font-family: "PoppinsSemiBold";
        src: url("../assets/fonts/Poppins/Poppins-Regular.ttf");
    }
    main {
        background-image: url("../assets/images/Hero_Content_Polos.png"); /*background pada hero section */
        height: 100vh;
        background-repeat: no-repeat;
        background-size: cover;
        color: #e4e4e4;
    }
    .overlay {
        background-color: hsla(0, 0%, 0%, 0.543);
    }
    button {
        font-family: "PoppinsSemiBold";
        background-color: #561306;
    }
    button:hover{
        background-color: #E4E4E4;
       
        color:#561306;
    }
</style>
