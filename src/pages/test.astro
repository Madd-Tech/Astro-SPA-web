---

---

<main class="min-h-screen flex items-center justify-center bg-gray-900 text-white p-6">
  <form id="feedbackForm" class="bg-gray-800 p-8 rounded-xl shadow-xl w-full max-w-md space-y-5">
    <h2 class="text-2xl font-bold text-center mb-6 text-amber-400">Feedback Form</h2>

    <div>
      <label for="name" class="block text-sm font-medium mb-2">Nama</label>
      <input
        type="text"
        id="name"
        name="from_name"
        class="w-full p-3 rounded-md bg-gray-700 border border-gray-600 focus:ring-2 focus:ring-amber-400"
        placeholder="Masukkan nama anda"
        required
      />
    </div>

    <div>
      <label for="email" class="block text-sm font-medium mb-2">Email</label>
      <input
        type="email"
        id="email"
        name="from_email"
        class="w-full p-3 rounded-md bg-gray-700 border border-gray-600 focus:ring-2 focus:ring-amber-400"
        placeholder="Masukkan email anda"
        required
      />
    </div>

    <div>
      <label for="message" class="block text-sm font-medium mb-2">Pesan</label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class="w-full p-3 rounded-md bg-gray-700 border border-gray-600 focus:ring-2 focus:ring-amber-400"
        placeholder="Tulis feedback anda di sini..."
        required
      ></textarea>
    </div>

    <button
      type="submit"
      class="w-full flex items-center justify-center gap-2 bg-amber-500 hover:bg-amber-600 text-gray-900 font-bold py-3 rounded-lg transition"
    >
      
      Kirim Feedback
    </button>

    <p id="feedbackStatus" class="text-center text-sm mt-3 text-gray-400"></p>
  </form>
</main>

<script  src="../components/function/email.js"></script>

